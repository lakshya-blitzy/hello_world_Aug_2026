{
  "name": "hello-world-service",
  "version": "1.0.0",
  "private": true,
  "description": "Express.js HTTP service with structured logging, centralised configuration and PM2 cluster-mode deployment readiness.",
  "license": "Apache-2.0",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js --update-env",
    "pm2:scale": "pm2 scale hello-world-service",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs hello-world-service",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "compression": "1.8.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3"
  }
}
