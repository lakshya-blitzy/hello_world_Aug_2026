# SPDX-License-Identifier: Apache-2.0
#
# hello-world-service -- environment configuration template.
#
# This committed template is the copyable environment contract;
# server/README.md is the canonical explanatory reference, and
# src/config/index.js enforces it. Copy this file once per host and edit what
# you need:
#
#     cp .env.example .env
#
# The real .env is an operator artefact and is git-ignored by the repository
# root .gitignore, so no real value is ever committed. Every value below is
# the built-in default, so a verbatim copy yields exactly default behaviour.
#
# All eight variables are OPTIONAL -- a default exists for each. Anything you
# do supply is validated at start-up by src/config/index.js, the only module
# permitted to read process.env; an invalid value aborts the process before
# the listener binds and reports every failure at once, not just the first.
#
# These eight are the whole surface, and that is enforced rather than merely
# stated: dotenv reserves three further variable names for its own control
# (DOTENV_CONFIG_QUIET, DOTENV_CONFIG_DEBUG and DOTENV_KEY), each of which
# would otherwise override that load whether it were set here or in the real
# environment, so src/config/index.js neutralises all three around it. Setting
# them in this file has no effect. One case is reported rather than ignored:
# DOTENV_KEY together with a .env.vault file staged beside this one aborts
# start-up, because that pairing prepares an encrypted source the service does
# not read and honouring it silently would be as surprising as dropping it
# silently. The service also reads NODE_APP_INSTANCE, which PM2 injects into
# each cluster worker and which is deliberately absent below because it is not
# yours to set; it is documented in that module's comments.
#
# BLANKING IS NOT THE SAME AS OMITTING. To accept a default, delete the whole
# assignment or comment it out -- do not leave the key with an empty value.
# "KEY=" is a supplied value that satisfies no validator, so it aborts
# start-up naming the key. That is deliberate: an empty value is what a broken
# template expansion or an unset substitution produces, and silently binding a
# default port or the all-interfaces host in that case looks like a healthy
# start.
#
# PRECEDENCE: the real process environment (where PM2 sets NODE_ENV) beats
# .env, which beats the built-in defaults. dotenv is loaded without override,
# so a key already present in the real environment wins and the .env value is
# silently ignored. This template and ecosystem.config.js therefore change
# together: adding any key to the descriptor's env block silently disables its
# counterpart here.

# --- Network ---------------------------------------------------------------

# PORT: TCP port the HTTP listener binds. Default 3000; validated as an integer in 1-65535.
PORT=3000

# HOST: address the listener binds to -- 0.0.0.0 accepts on every interface, 127.0.0.1 restricts to loopback. Default 0.0.0.0; validated as a non-empty string.
HOST=0.0.0.0

# --- Runtime ---------------------------------------------------------------

# NODE_ENV: environment name, which selects production behaviour (raw NDJSON logs, 5xx messages masked in responses). Default development; one of development, test or production. PM2 owns this key in production: ecosystem.config.js injects NODE_ENV=production into each worker's real environment before any application code runs, and dotenv does not override the real environment, so a NODE_ENV set here is silently ignored whenever the service runs under PM2.
NODE_ENV=development

# --- Logging ---------------------------------------------------------------

# LOG_LEVEL: level of the pino root logger. Default info; one of trace, debug or info -- and deliberately nothing higher, because warn and above would filter the info-level access record the service guarantees for every successful request, making that guarantee false.
LOG_LEVEL=info

# --- Shutdown and drain ----------------------------------------------------

# SHUTDOWN_TIMEOUT_MS: total drain budget in milliseconds, after which shutdown is forced. Default 10000; integer, 3000-10000 inclusive -- 10000 is the ceiling because the budget must stay below PM2's kill_timeout of 12000 (fixed in ecosystem.config.js), leaving a 2000 ms margin so the application, not the supervisor, decides how a drain ends.
SHUTDOWN_TIMEOUT_MS=10000

# DRAIN_DELAY_MS: deregistration window inside the drain budget, during which GET /health/ready answers 503 while the listener is still accepting, so a poller can observe the negative answer and stop sending new work -- without the window the listener would close immediately and the probe could never be answered, the connection being refused instead. Default 2000; integer, 0 to SHUTDOWN_TIMEOUT_MS minus 1000.
DRAIN_DELAY_MS=2000

# --- Request handling ------------------------------------------------------

# BODY_LIMIT: maximum request body size passed to both body parsers; a larger body is rejected with 413. Default 100kb; must match ^\d+(kb|mb)?$ case-insensitively and resolve to at most 1 MB, because an unbounded "valid" size would defeat the memory bound the limit exists to provide.
BODY_LIMIT=100kb

# TRUST_PROXY: whether Express trusts X-Forwarded-* headers. Default false; true or false -- false because with no known topology any direct client could forge X-Forwarded-For and X-Forwarded-Proto and have them logged as its real address and scheme; set true only when a reverse proxy is actually in front of the service, is the sole path to it, and overwrites rather than appends client-supplied X-Forwarded-* headers.
TRUST_PROXY=false
